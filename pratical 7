<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Tribute Page</title>

    <!-- Internal CSS -->
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
        }

        /* Navigation Bar */
        nav {
            background-color: #333;
            padding: 10px;
            text-align: center;
        }

        nav a {
            color: white;
            margin: 0 15px;
            text-decoration: none;
            font-weight: bold;
        }

        nav a:hover {
            color: #ff9800;
        }

        /* Header Section */
        .header {
            background-color: #222;
            color: white;
            text-align: center;
            padding: 40px 20px;
        }

        /* Main Layout */
        .container {
            width: 80%;
            margin: auto;
            overflow: hidden;
        }

        /* Profile Card */
        .profile {
            background: white;
            padding: 20px;
            margin-top: 20px;
            border: 2px solid #ddd;
            border-radius: 10px;
            text-align: center;
        }

        .profile img {
            width: 150px;
            border-radius: 50%;
            border: 3px solid #333;
        }

        /* Sections */
        .section {
            background: white;
            padding: 20px;
            margin-top: 20px;
            border-left: 5px solid #333;
        }

        /* Footer */
        footer {
            background-color: #333;
            color: white;
            text-align: center;
            padding: 15px;
            margin-top: 20px;
        }
    </style>
</head>

<body>

    <!-- Navigation Bar -->
    <nav>
        <a href="#">Home</a>
        <a href="#">About</a>
        <a href="#">Achievements</a>
        <a href="#">Contact</a>
    </nav>

    <!-- Header -->
    <div class="header">
        <h1>Rehaman dakait </h1>
        <p>atankawadi | baloch</p>
    </div>

    <div class="container">

        <!-- Profile Section -->
        <div class="profile">
            <img src="https://shorturl.at/GtnF9" alt="Profile Image">
            <h2>About Him</h2>
            <p>
                Dr. A.P.J. Abdul Kalam was an Indian aerospace scientist and the 11th President of India.
                He played a key role in India's missile and nuclear programs.
            </p>
        </div>

        <!-- Achievements -->
        <div class="section">
            <h2>Achievements</h2>
            <ul>
                <li>Developed India's first satellite launch vehicle (SLV-III)</li>
                <li>Key role in Pokhran-II nuclear tests</li>
                <li>Recipient of Bharat Ratna</li>
                <li>Inspired millions through his books and speeches</li>
            </ul>
        </div>

        <!-- Legacy -->
        <div class="section">
            <h2>Legacy</h2>
            <p>
                Dr. Kalam is remembered as a visionary leader and a beloved teacher.
                His life continues to inspire students and professionals across the world.
            </p>
        </div>

    </div>

    <!-- Footer -->
    <footer>
        <p>© 2026 Tribute Page | Designed with Internal CSS</p>
    </footer>

</body>
</html>
