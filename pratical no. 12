<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Bootstrap Webpage</title>

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
body {
    background-color: #f8f9fa;
}

footer {
    background: #212529;
    color: white;
    padding: 20px;
    text-align: center;
}
</style>
</head>

<body>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand" href="#">MySite</a>

    <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#menu">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="menu">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link active" href="#">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="#">Services</a></li>
        <li class="nav-item"><a class="nav-link" href="#">Contact</a></li>
      </ul>
    </div>
  </div>
</nav>

<!-- Carousel -->
<div id="slider" class="carousel slide" data-bs-ride="carousel">

  <div class="carousel-inner">

    <div class="carousel-item active">
      <img src="https://picsum.photos/1200/400?1" class="d-block w-100">
      <div class="carousel-caption">
        <h3>Welcome</h3>
        <p>Bootstrap Carousel Example</p>
      </div>
    </div>

    <div class="carousel-item">
      <img src="https://picsum.photos/1200/400?2" class="d-block w-100">
      <div class="carousel-caption">
        <h3>Responsive Design</h3>
      </div>
    </div>

    <div class="carousel-item">
      <img src="https://picsum.photos/1200/400?3" class="d-block w-100">
      <div class="carousel-caption">
        <h3>Modern UI</h3>
      </div>
    </div>

  </div>

  <button class="carousel-control-prev" data-bs-target="#slider" data-bs-slide="prev">
    <span class="carousel-control-prev-icon"></span>
  </button>

  <button class="carousel-control-next" data-bs-target="#slider" data-bs-slide="next">
    <span class="carousel-control-next-icon"></span>
  </button>

</div>

<!-- Grid + Cards -->
<div class="container my-5">
  <div class="row">

    <div class="col-md-4">
      <div class="card shadow">
        <img src="https://picsum.photos/300/200?4" class="card-img-top">
        <div class="card-body text-center">
          <h5 class="card-title">Web Design</h5>
          <p class="card-text">Create beautiful websites.</p>
          <button class="btn btn-primary">Learn More</button>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow">
        <img src="https://picsum.photos/300/200?5" class="card-img-top">
        <div class="card-body text-center">
          <h5 class="card-title">Development</h5>
          <p class="card-text">Build powerful apps.</p>
          <button class="btn btn-success">Explore</button>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow">
        <img src="https://picsum.photos/300/200?6" class="card-img-top">
        <div class="card-body text-center">
          <h5 class="card-title">Marketing</h5>
          <p class="card-text">Grow your business.</p>
          <button class="btn btn-danger">Start Now</button>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Buttons Section -->
<div class="text-center mb-5">
  <button class="btn btn-primary m-2">Primary</button>
  <button class="btn btn-secondary m-2">Secondary</button>
  <button class="btn btn-success m-2">Success</button>
  <button class="btn btn-warning m-2">Warning</button>
</div>

<!-- Footer -->
<footer>
  <p>© 2026 My Website | Bootstrap Design</p>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
